    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Simulated payer status for MOCK requests - nothing is sent to Availity or any insurer\nconst outcome = String($('Config - Poller').first().json.MOCK_POLL_OUTCOME || 'approved').toLowerCase();\nconst responses = {\n  approved: { status: 'approved', authorizationNumber: 'MOCK-A' + String(Date.now()).slice(-6),\n              certificationEffectiveDate: $now.toFormat('yyyy-MM-dd'),\n              certificationExpirationDate: $now.plus({ days: 90 }).toFormat('yyyy-MM-dd') },\n  denied:   { status: 'denied', denialReasonCode: 'NMN',\n              denialReason: 'Not medically necessary - insufficient evidence of failed conservative therapy' },\n  pending:  { status: 'pending', message: 'Still pended for medical review' },\n  error:    { error: 'Mock payer timeout' }\n};\nreturn { json: { ...(responses[outcome] || responses.approved), mock: true } };"
      },
      "id": "d7d9178b-acc7-4d99-934d-be6e3619bb31",
      "name": "Code - Mock Status Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config - Poller').first().json.AVAILITY_SERVICE_REVIEW_URL }}/{{ encodeURIComponent($json.tracking_id || '') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "e84de684-a5fc-4844-b766-a0f7e091e04a",
      "name": "Availity - Get Service Review Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        480
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "oAuth2Api (configure in n8n)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn the payer's status reply into one outcome per request\nconst rec = $('Filter - Has Due Requests').item.json;\nconst cfg = $('Config - Poller').first().json;\nconst r = $json || {};\nconst raw = String(r.status || r.authorizationStatus || r.certificationStatus || r.statusCode || '').toLowerCase();\n\nlet observed = 'check_failed';   // could not read a decision this time\nif (['approved', 'a1', 'certified'].includes(raw)) observed = 'approved';\nelse if (['denied', 'a3', 'not_certified', 'rejected'].includes(raw)) observed = 'denied';\nelse if (['pending', 'a4', 'p', 'pended', 'in process', '0'].includes(raw)) observed = 'pending';\n\nconst checks = Number(rec.check_count || 0) + 1;\nconst maxChecks = Number(cfg.MAX_STATUS_CHECKS || 28);\nconst waiting = observed === 'pending' || observed === 'check_failed';\nconst paStatus = waiting && checks >= maxChecks ? 'stale' : observed;\nconst hours = Number(cfg.PENDING_POLL_HOURS || 6);\n\nconst errText = v => (v && typeof v === 'object') ? (v.message || JSON.stringify(v)) : v;\nlet problem = null;\nif (observed === 'check_failed') {\n  problem = String(errText(r.error) || r.userMessage || ('Unrecognised status: ' + (raw || 'none'))).slice(0, 500);\n}\nif (paStatus === 'stale' && !problem) problem = 'Still pending after ' + checks + ' checks';\n\nreturn { json: {\n  request_id: rec.request_id,\n  tracking_id: rec.tracking_id || null,\n  procedure_code: rec.procedure_code || null,\n  mock: rec.is_mock === true,\n  paStatus,                       // approved | denied | pending | check_failed | stale\n  checks,\n  nextCheckAt: paStatus === 'pending' || paStatus === 'check_failed' ? $now.plus({ hours }).toUTC().toISO() : null,\n  authNumber: r.authorizationNumber || r.authNumber || null,\n  effectiveDate: r.certificationEffectiveDate || null,\n  expirationDate: r.certificationExpirationDate || null,\n  denialReason: r.denialReason || r.reason || null,\n  denialCode: r.denialReasonCode || r.reasonCode || null,\n  problem\n} };"
      },
      "id": "251fdc7a-c3a0-46f4-937a-325818e90d7d",
      "name": "Code - Evaluate Status Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config - Poller').first().json.SUPABASE_URL }}/rest/v1/rpc/log_prior_auth",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (x => JSON.stringify({ p: { request_id: x.request_id, action: 'status_check', actor: 'n8n', status: ({ approved: 'approved', denied: 'denied', pending: 'pending', check_failed: 'pending', stale: 'stale' })[x.paStatus], check_count: x.checks, last_checked_at: $now.toUTC().toISO(), next_check_at: x.nextCheckAt, is_approved: x.paStatus === 'approved' ? true : (x.paStatus === 'denied' ? false : null), auth_number: x.authNumber, auth_effective_date: x.effectiveDate, auth_expiration_date: x.expirationDate, denial_code: x.denialCode, denial_reason: x.denialReason, needs_manual_review: x.paStatus === 'denied' || x.paStatus === 'stale' ? true : null, manual_review_reason: x.paStatus === 'denied' ? 'Payer denied (found by status check) - prepare an appeal' : (x.paStatus === 'stale' ? 'No payer decision after ' + x.checks + ' checks - follow up with the payer' : null), last_error: x.problem, n8n_execution_id: $execution.id, details: { outcome: x.paStatus, mock: x.mock } } }))($json) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "175eaf03-c28c-4401-a78a-603a3ed62871",
      "name": "Supabase - Log Status Check",
