    {
      "parameters": {
        "sendTo": "={{ $('Config - Poller').first().json.CARE_TEAM_EMAIL }}",
        "subject": "={{ $('Code - Evaluate Status Check').item.json.mock ? '[TEST] ' : '' }}Prior Auth APPROVED - {{ $('Code - Evaluate Status Check').item.json.request_id }}",
        "message": "=<p><strong>Prior authorization approved</strong> (found by the automatic status check)</p><p>Request ID: {{ $('Code - Evaluate Status Check').item.json.request_id }}<br>Authorization #: <strong>{{ $('Code - Evaluate Status Check').item.json.authNumber }}</strong><br>Valid: {{ $('Code - Evaluate Status Check').item.json.effectiveDate }} to {{ $('Code - Evaluate Status Check').item.json.expirationDate }}<br>Procedure: {{ $('Code - Evaluate Status Check').item.json.procedure_code }}</p><p>Patient details are in Epic / the audit log.</p>",
        "options": {
