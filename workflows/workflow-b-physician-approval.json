    {
      "parameters": {
        "jsCode": "const record = $('Get Stored Auth Record').first().json;\nconst decrypted = $input.first().json;\n\nif (!record || !record.request_id) {\n  return { json: { error: true, message: 'No stored record found for this request' } };\n}\n\nconst phi = Array.isArray(decrypted) ? (decrypted[0] || {}) : (decrypted || {});\nconst extraction = record.clinical_extraction || {};\n\nconst payload = {\n  requestId: record.request_id,\n  requesting_physician_name: record.requesting_physician_name || '',\n  patient_id: record.patient_id,\n  encounter_id: record.encounter_id,\n  procedure_code: record.procedure_code,\n  diagnosis_code: record.diagnosis_codes || [],\n  physician_npi: record.physician_npi,\n  payer_id: record.payer_id,\n  coverage: {\n    payerName: record.payer_name,\n    memberId: record.payer_member_id || null\n  },\n  patient: {\n    name: phi.patient_name || '',\n    raw: { birthDate: phi.patient_dob || '' }\n  },\n  ai_extraction: {\n    urgency_level: record.urgency_level || 'routine',\n    procedure_requested: extraction.procedure_requested || record.procedure_code,\n    medical_necessity_statement: extraction.medical_necessity_statement || '',\n    clinical_justification: extraction.clinical_justification || '',\n    supporting_evidence: extraction.supporting_evidence || [],\n    alternative_treatments_tried: extraction.alternative_treatments_tried || []\n  }\n};\n\nreturn { json: { ...payload, approvedByPhysicianAt: new Date().toISOString() } };"
      },
