      "parameters": {
        "jsCode": "const requestId = $('Extract requestId (Approve)').first().json.requestId;\nconst rows = $input.all().map(i => i.json);\nconst row = rows[0];\n\nif (!row) {\n  return { json: { valid: false, requestId, reason: 'No approval record found for this request. Workflow A must create a physician_approvals row (decision=NULL, expires_at=now()+24h) when it sends the review email.' } };\n}\n\nconst notExpired = row.expires_at && new Date(row.expires_at) > new Date();\nconst notDecided = row.decision === null || row.decision === undefined || row.decision === '';\n\nreturn {\n  json: {\n    valid: Boolean(notExpired && notDecided),\n    requestId,\n    approval_id: row.approval_id,\n    reason: !notExpired ? 'expired' : (!notDecided ? 'already_decided' : 'ok')\n  }\n};"
      },
